---
import type { Language } from "@language/language";
import { BugIcon } from "@navikt/aksel-icons";
import {
  BodyShort,
  Box,
  Button,
  Heading,
  Link,
  List,
  VStack,
} from "@navikt/ds-react";
import Layout from "@src/layouts/Layout.astro";
import { errorReportingUrl, minSideUrl, navNoUrl } from "@src/urls";

const language = Astro.currentLocale as Language;
---

<Layout title="Siden finnes ikke" language={language}>
  <Box paddingBlock="space-80 space-64" data-aksel-template="404-v2">
    <VStack>
      <VStack align="start">
        <div>
          <Heading level="1" size="large" spacing>
            Beklager, vi fant ikke siden
          </Heading>
          <BodyShort>
            Denne siden kan være slettet eller flyttet, eller det er en feil i
            lenken.
          </BodyShort>
          <List>
            <List.Item>Bruk gjerne søket eller menyen</List.Item>
            <List.Item>
              <Link href={navNoUrl}>Gå til forsiden</Link>
            </List.Item>
          </List>
        </div>
        <Button as="a" href={minSideUrl}> Gå til Min side </Button>
        <Link href={errorReportingUrl}>
          <BugIcon aria-hidden />
          Meld gjerne fra om at lenken ikke virker
        </Link>
      </VStack>
    </VStack>
  </Box>
</Layout>
